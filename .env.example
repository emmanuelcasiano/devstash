# Neon PostgreSQL — pooled connection, used at runtime by the app (PrismaNeon adapter)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/devstash?sslmode=require"

# Neon PostgreSQL — direct (unpooled) connection, used by the Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/devstash?sslmode=require"

# NextAuth v5 — generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app credentials (Settings → Developer settings → OAuth Apps)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend — transactional email (verification links). Key from https://resend.com/api-keys
RESEND_API_KEY=""
# From-address for verification emails. Must be on a Resend-verified domain;
# for local dev "DevStash <onboarding@resend.dev>" works out of the box.
EMAIL_FROM="DevStash <onboarding@resend.dev>"
# Absolute base URL used to build links inside emails and Stripe return URLs
# (checkout success/cancel, billing portal). No trailing slash.
APP_URL="http://localhost:3000"

# Master switch for the email-verification-on-register requirement. Set to the
# literal "false" to turn it off entirely: new accounts are marked verified on
# creation, no link is sent, and unverified accounts can still sign in. Any other
# value — or leaving this unset — keeps verification on. Handy while Resend has
# no verified domain and can only deliver to the account owner.
EMAIL_VERIFICATION_ENABLED="true"

# Upstash Redis — backs auth rate limiting (sign-in, register, password reset,
# email verification). Create a database at https://console.upstash.com and copy
# the REST URL + token. If either is unset, rate limiting is disabled (fail-open).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 Storag
R2_ACCOUNT_ID=''
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
R2_BUCKET_NAME=''
R2_PUBLIC_URL=''

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# Master switch for Pro gating. Set to the literal "false" to give every user Pro
# access (no item/collection limits, file & image uploads allowed) — handy in
# development before Stripe is set up. Any other value, or leaving this unset,
# keeps gating on.
PRO_GATING_ENABLED="true"

# Open AI Key
OPENAI_API_KEY=''

# Google Gemini — powers the AI auto-tag suggestion feature (and future Pro AI
# features). Key from https://aistudio.google.com/apikey; in the Cloud Console,
# restrict it to the "Generative Language API" only. If unset, the "Suggest
# Tags" button still shows for Pro users but returns a friendly error instead
# of calling the API.
GEMINI_API_KEY=""
